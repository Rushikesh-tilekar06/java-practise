import java.util.*;
public class basics{
    public static void main(String[] args){
    System.out.println("enter two numbers");
    Scanner sc = new Scanner(System.in);
    int b = sc.nextInt();
    int a = sc.nextInt();
    int sum = a+b;
    System.out.println("sum of two numbers"  +  sum);
}
}
